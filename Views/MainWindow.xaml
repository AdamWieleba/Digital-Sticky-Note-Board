<Window x:Class="DigitalStickyNoteBoard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Digital Sticky Note Board"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="500"
        Background="#F2F2F2">

    <DockPanel>

        <!-- Pasek narzędzi -->
        <Border DockPanel.Dock="Top"
                Background="#FFFFFF"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="15">

            <StackPanel Orientation="Horizontal">

                <Button Content="+  Nowa notatka"
                        Command="{Binding AddNoteCommand}"
                        Padding="15,8"
                        FontSize="14"
                        Cursor="Hand"/>

                <Button Content="Usuń notatkę"
                        Command="{Binding DeleteNoteCommand}"
                        Padding="15,8"
                        Margin="10,0,0,0"
                        FontSize="14"
                        Cursor="Hand"/>

            </StackPanel>

        </Border>

        <!-- Obszar tablicy -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

            <Canvas x:Name="BoardCanvas"
                    Width="2000"
                    Height="1200"
                    Background="#EAEAEA"
                    MouseLeftButtonDown="Board_MouseLeftButtonDown"
                    MouseMove="BoardCanvas_MouseMove"
                    MouseLeftButtonUp="BoardCanvas_MouseLeftButtonUp">

                <ItemsControl ItemsSource="{Binding Notes}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left"
                                    Value="{Binding X}" />

                            <Setter Property="Canvas.Top"
                                    Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Width="220"
                                    MinHeight="180"
                                    Background="{Binding Color}"
                                    Padding="15"
                                    CornerRadius="3"
                                    BorderThickness="3"
                                    MouseLeftButtonDown="Note_MouseLeftButtonDown">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush"
                                                Value="Transparent"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}"
                                                        Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="#333333"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Tytuł -->
                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="18"
                                             FontWeight="SemiBold"
                                             Foreground="#333333"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             Margin="0,0,0,10"
                                             TextWrapping="NoWrap"
                                             AcceptsReturn="False"
                                             KeyDown="TitleTextBox_KeyDown"/>

                                    <!-- Treść -->
                                    <TextBox Grid.Row="1"
                                             Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="14"
                                             Foreground="#444444"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             KeyDown="ContentTextBox_KeyDown"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </Canvas>

        </ScrollViewer>

    </DockPanel>

</Window>
